.work/*
# The content SOURCES live in .work and are the editable truth — the js/
# data files are generated from them. Scratch (tmp, hf, logs, shards) stays
# out; the entries and the editorial briefs are backed up like code.
!.work/entries-*.json
!.work/BRIEF-*.md
!.work/rw/
.work/rw/*
!.work/rw/BRIEF.md
!.work/rw/CMP-BRIEF.md
__pycache__/
*.pyc

# Build dependencies, not shipped assets.
#   .venv-tts   ~226 MB  — recreate: uv venv --python 3.12 .venv-tts
#   tools/voices ~109 MB — recreate: .venv-tts/bin/python -m piper.download_voices \
#                            --download-dir tools/voices en_US-lessac-high
# audio/ IS committed on purpose: GitHub Pages serves it, and the app streams
# clips from there on demand.
.venv-tts/
tools/voices/

# Vercel project link (ids, machine-local)
.vercel/
